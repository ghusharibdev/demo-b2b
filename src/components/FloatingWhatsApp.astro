---
import { whatsappUrl } from '../data/site';
import WhatsAppIcon from './WhatsAppIcon.astro';

const orderUrl = whatsappUrl('Assalam-o-Alaikum, I saw your collection, I want to order.');
---

<a
  href={orderUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="wa-float wa-button fixed bottom-[calc(1.25rem+env(safe-area-inset-bottom))] right-5 z-40 inline-flex h-14 w-14 items-center justify-center rounded-full bg-whatsapp text-white shadow-float sm:bottom-[calc(1.5rem+env(safe-area-inset-bottom))] sm:right-6"
  aria-label="Order on WhatsApp"
  title="Order on WhatsApp"
>
  <WhatsAppIcon class="h-7 w-7" />
</a>
