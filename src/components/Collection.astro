---
import { products } from '../data/products';
import { whatsappUrl } from '../data/site';
import ProductCard from './ProductCard.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';

const categories = [
  { value: 'all', label: 'All' },
  ...Array.from(new Set(products.map((product) => product.category))).map((category) => ({
    value: category,
    label: category,
  })),
];

const brands = [
  { value: 'all', label: 'All' },
  ...Array.from(new Set(products.map((product) => product.brand))).map((brand) => ({
    value: brand,
    label: brand,
  })),
];

// Demo shows 4 first; a larger catalogue uses 12 per page of Load More.
const initialVisible = products.length > 12 ? 12 : 4;
const orderUrl = whatsappUrl();
---

<section id="collection" class="scroll-mt-32 md:scroll-mt-24">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-16">
    <div class="max-w-2xl">
      <p class="eyebrow">Wholesale catalogue</p>
      <h2 class="section-title mt-3" data-reveal>Collection</h2>
    </div>

    <div class="collection-tools mt-8">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <div class="relative w-full sm:max-w-md">
          <svg
            class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-muted"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <circle cx="8.5" cy="8.5" r="5.25" />
            <path d="m12.5 12.5 4 4" stroke-linecap="round" />
          </svg>
          <input
            id="product-search"
            type="search"
            class="h-12 w-full rounded-xl border border-line bg-white py-3 pl-11 pr-4 text-[15px] font-normal text-ink placeholder:text-muted focus:border-primary focus-visible:outline-none"
            placeholder="Search - Dhanak, Velvet, Wool..."
            autocomplete="off"
            spellcheck="false"
            aria-label="Search products"
            aria-controls="product-grid"
            data-search-input
          />
        </div>

        <div class="relative w-full sm:ml-auto sm:w-56">
          <label for="product-sort" class="sr-only">Sort products</label>
          <select
            id="product-sort"
            class="h-12 w-full appearance-none rounded-xl border border-line bg-white px-4 pr-10 text-sm font-medium text-body focus:border-primary focus-visible:outline-none"
            data-sort-select
          >
            <option value="featured">Featured</option>
            <option value="price-asc">Price Low to High</option>
            <option value="price-desc">Price High to Low</option>
            <option value="newest">Newest</option>
          </select>
          <svg
            class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-muted"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <path d="m5.5 8 4.5 4.5L14.5 8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
      </div>

      <div class="mt-5 space-y-4">
        <div>
          <p id="category-filter-label" class="mb-2 text-[11px] font-medium uppercase tracking-[0.14em] text-body">
            Category
          </p>
          <div
            class="collection-filters items-center gap-2"
            role="group"
            aria-labelledby="category-filter-label"
            data-filter-group
          >
            {
              categories.map((category, index) => (
                <button
                  type="button"
                  class="filter-button"
                  data-filter={category.value}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                  aria-controls="product-grid"
                >
                  {category.label}
                </button>
              ))
            }
          </div>
        </div>

        <div>
          <p id="brand-filter-label" class="mb-2 text-[11px] font-medium uppercase tracking-[0.14em] text-body">
            Brand
          </p>
          <div
            class="collection-filters items-center gap-2"
            role="group"
            aria-labelledby="brand-filter-label"
            data-brand-group
          >
            {
              brands.map((brand, index) => (
                <button
                  type="button"
                  class="filter-button"
                  data-brand-filter={brand.value}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                  aria-controls="product-grid"
                >
                  {brand.label}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
        <p class="text-[13px] leading-[1.6] text-body" data-product-count>
          Showing {Math.min(initialVisible, products.length)} of {products.length} products
        </p>
        <button
          type="button"
          class="inline-flex min-h-11 items-center gap-1.5 text-xs font-semibold text-primary underline-offset-4 hover:text-primary-hover hover:underline"
          data-clear-filters
          hidden
        >
          <svg
            class="h-3.5 w-3.5"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <path d="m5 5 10 10M15 5 5 15" stroke-linecap="round" />
          </svg>
          Clear Filters
        </button>
      </div>
    </div>

    <p class="sr-only" aria-live="polite" data-filter-status></p>

    <div
      id="product-grid"
      class="mt-6 grid auto-rows-fr grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6"
      data-product-grid
      data-initial-visible={initialVisible}
      data-load-step={initialVisible}
    >
      {
        products.map((product, index) => (
          <ProductCard product={product} index={index} revealDelay={index * 80} />
        ))
      }
    </div>

    <div class="flex justify-center">
      <button
        type="button"
        class="btn btn-outline mt-8 min-w-40 gap-2"
        data-load-more
        aria-controls="product-grid"
        hidden
      >
        Load More
        <svg
          class="h-4 w-4"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <path d="M10 4v12M5.5 11.5 10 16l4.5-4.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>

    <div
      class="mt-6 rounded-2xl border border-line bg-warm px-6 py-12 text-center"
      data-empty-state
      hidden
    >
      <span class="mx-auto flex h-11 w-11 items-center justify-center rounded-full border border-line bg-cream text-primary">
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.25" />
          <path d="m12.5 12.5 4 4" stroke-linecap="round" />
        </svg>
      </span>
      <p class="mt-4 text-[16px] font-semibold leading-[1.4] tracking-[-0.01em] text-ink">
        No products found - WhatsApp pe pooch lein
      </p>
      <a
        href={orderUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="wa-button btn btn-accent mt-5 gap-2"
      >
        <WhatsAppIcon class="h-4 w-4" />
        Ask on WhatsApp
      </a>
    </div>

    <dialog
      class="lightbox m-auto w-[calc(100%-2rem)] max-w-4xl rounded-2xl border border-line bg-surface p-0 text-ink shadow-float"
      data-lightbox
      aria-labelledby="lightbox-name"
    >
      <button
        type="button"
        class="absolute right-3 top-3 z-20 flex h-10 w-10 items-center justify-center rounded-full border border-line bg-white/95 text-ink hover:text-primary"
        data-lightbox-close
        aria-label="Close image viewer"
      >
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="m5 5 10 10M15 5 5 15" stroke-linecap="round" />
        </svg>
      </button>

      <div class="grid sm:grid-cols-[1.05fr_0.95fr]">
        <div class="flex items-center justify-center bg-[#F0E2D6] p-3 sm:p-4">
          <img
            src="/images/hero.jpg"
            alt=""
            width="1080"
            height="1350"
            class="max-h-[55vh] w-full rounded-lg object-contain sm:max-h-[78vh]"
            data-lightbox-image
          />
        </div>
        <div class="flex flex-col p-6 sm:p-8">
          <p class="eyebrow">Lahore Boutique</p>
          <h3
            id="lightbox-name"
            class="mt-3 text-[20px] font-semibold leading-[1.4] tracking-[-0.01em] text-ink"
            data-lightbox-name
          ></h3>
          <p
            class="mt-2 line-clamp-3 text-[15px] leading-[1.6] tracking-[-0.01em] text-body"
            data-lightbox-spec
          ></p>

          <div class="mt-6 sm:mt-auto sm:pt-8">
            <div class="flex flex-wrap items-baseline gap-x-2">
              <span
                class="text-[18px] font-bold leading-[1.4] text-primary underline decoration-gold decoration-1 underline-offset-4"
                data-lightbox-price
              ></span>
              <span class="text-[11px] font-medium text-muted">Wholesale</span>
            </div>
            <a
              href={orderUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="wa-button btn btn-accent mt-4 w-full gap-2"
              data-lightbox-order
            >
              <WhatsAppIcon class="h-4 w-4" />
              Order on WhatsApp
            </a>
          </div>
        </div>
      </div>
    </dialog>
  </div>
</section>
