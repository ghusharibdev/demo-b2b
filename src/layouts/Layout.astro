---
import '../styles/global.css';
import { site, siteUrl } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Lahore Boutique | Wholesale Suits & Shawls in Lahore',
  description = 'Wholesale suits, shawls and dupattas from Lahore Boutique in Allama Iqbal Town, Lahore. Ready stock, wholesale prices, and nationwide delivery. Order on WhatsApp.',
} = Astro.props;

const canonicalUrl = siteUrl('/');
const heroImageUrl = siteUrl('/images/hero.jpg');

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ClothingStore',
  '@id': `${canonicalUrl}#store`,
  name: site.name,
  slogan: site.tagline,
  url: canonicalUrl,
  description:
    'Wholesale suits and shawls based in Allama Iqbal Town, Lahore, with delivery across Pakistan.',
  telephone: site.phoneDisplay,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Allama Iqbal Town',
    addressLocality: 'Lahore',
    addressCountry: 'PK',
  },
  openingHours: 'Mo-Su 00:00-23:59',
  areaServed: ['Lahore', 'Pakistan'],
  currenciesAccepted: 'PKR',
  priceRange: 'PKR 1,800 - 2,850',
  image: heroImageUrl,
  logo: siteUrl('/favicon.svg'),
  sameAs: [`https://wa.me/${site.whatsappNumber}`],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFF8F2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preload" as="image" href="/images/hero.jpg" fetchpriority="high" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_PK" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={heroImageUrl} />
    <meta property="og:image:width" content="1080" />
    <meta property="og:image:height" content="1350" />
    <meta property="og:image:alt" content="DHANAK Printed 3pc beige maroon hearts model" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={heroImageUrl} />
    <meta name="twitter:image:alt" content="DHANAK Printed 3pc beige maroon hearts model" />

    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/sitemap.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');

        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('motion-ready');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-cream font-sans text-body" data-site-url={site.url}>
    <a
      href="#main-content"
      class="sr-only inline-flex min-h-11 items-center justify-center rounded-lg bg-primary px-4 text-sm font-medium text-white focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100]"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
